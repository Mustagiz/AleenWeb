# Aleen website — server-side configuration
# Copy to .env locally (git-ignored). On Vercel set these under
# Project Settings -> Environment Variables.
#
# Local runs read it via:  node --env-file=.env server.js   (Node 20+)

# ---- Firestore (required) ----
# A Google service account with the "Cloud Datastore User" role on the project.
# A service account is authorised by IAM, so it works even when firestore.rules
# denies all public access. Create one in the Google Cloud console:
#   IAM & Admin -> Service Accounts -> Create -> Keys -> Add key -> JSON
#
# Supply it ONE of these three ways:
#   1. FIREBASE_SERVICE_ACCOUNT_BASE64  <- recommended for Vercel
#        base64 -i service-account.json | pbcopy
#   2. FIREBASE_SERVICE_ACCOUNT         <- the raw JSON on a single line
#   3. GOOGLE_APPLICATION_CREDENTIALS   <- path to the JSON file (local dev)
FIREBASE_PROJECT_ID=aleen-a5c32
FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Legacy public API key. Only works while firestore.rules is OPEN, so it is a
# migration aid only. Leave unset once the service account above works.
FIREBASE_API_KEY=AIzaSyDJOIWVS5LwRfhLLEa_lT51CI6ndQp1eXQ

# ---- Auth (required, no defaults) ----
# Password for the atelier console.
ATELIER_ADMIN_PASSWORD=
# HMAC signing key for admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ATELIER_AUTH_SECRET=
