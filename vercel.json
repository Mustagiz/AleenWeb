{
  "version": 2,
  "buildCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|webp|svg|woff|woff2|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin/catalog", "destination": "/api/catalog" },
    { "source": "/api/admin/women-collections", "destination": "/api/women-collections" },
    { "source": "/api/admin/carousel", "destination": "/api/carousel" },
    { "source": "/api/admin/hero-rotator", "destination": "/api/hero-rotator" },
    { "source": "/api/admin/mega-banner", "destination": "/api/mega-banner" },
    { "source": "/api/admin/users", "destination": "/api/admin/account" },
    { "source": "/api/admin/password", "destination": "/api/admin/account" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/collections", "destination": "/collections.html" },
    { "source": "/our-story", "destination": "/our-story.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/dresses", "destination": "/dresses.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" },
    { "source": "/the-complete-journey", "destination": "/the-complete-journey.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/sitemap", "destination": "/sitemap.html" }
  ]
}
